[Unit]
Description=Offsite backup of the folding stats data to R2
After=network-online.target
Wants=network-online.target
# No Restart= and no StartLimit override on purpose. A backup that failed should stay
# failed and visible in `systemctl list-units --failed` until someone looks, rather
# than retrying quietly until the timer comes round again anyway.

[Service]
Type=oneshot
User=folding
Group=folding
Environment=RCLONE_CONFIG=/etc/folding/rclone.conf
ExecStart=/usr/local/bin/folding-backup.sh

# Reading a WAL-mode database means touching its -shm file, so this runs as the owner
# of the data rather than as root reaching in.
# Reading seven gigabytes of archive fills the page cache with it — the first run was
# accounted 7G peak, all of it reclaimable cache rather than anything leaked. The cost
# is not memory pressure but eviction: it pushes foldingd's cached database pages out,
# so the site runs cold for a while after every nightly backup. Capping the cgroup makes
# the kernel reclaim this job's own cache instead of somebody else's.
MemoryHigh=512M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/folding
ReadWritePaths=/var/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
